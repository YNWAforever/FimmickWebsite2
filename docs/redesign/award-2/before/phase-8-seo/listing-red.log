ame\\\":\\\"card card--link\\\",\\\"href\\\":\\\"/en/knowledge-hub/creative-video-questions\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"card-meta\\\",\\\"children\\\":[\\\"18 Apr 2019\\\",null]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"Creative Video︰短片營銷要考慮的5大問題\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"small muted\\\",\\\"children\\\":\\\"短片已經與我們的生活密不可分，不少品牌都希望製作短片以增加與顧客的互動與提昇宣傳計劃的成效。話雖如此，短片製作成本比圖片高出許多，各大社交平台又有截然不同的要求，我們應該從何開始？怎樣才能發揮短片營銷最大功能？\\\"}]]}]\\n35:[\\\"$\\\",\\\"$L16\\\",\\\"content-marketing-strategies\\\",{\\\"className\\\":\\\"card card--link\\\",\\\"href\\\":\\\"/en/knowledge-hub/content-marketing-strategies\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"card-meta\\\",\\\"children\\\":[\\\"14 Dec 2018\\\",null]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"Content Marketing︰四步制定致勝內容營銷策略\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"small muted\\\",\\\"children\\\":\\\"近年有不少品牌成功靠內容營銷突圍，令內容營銷成為大家認可的重要宣傳策略。但是萬事起頭難，我們應該分享什麼內容才能吸引顧客？如何才能達到宣傳效益但又不會太 hardsell？\\\"}]]}]\\n36:[\\\"$\\\",\\\"$L16\\\",\\\"finance-industry-trends\\\",{\\\"className\\\":\\\"card card--link\\\",\\\"href\\\":\\\"/en/knowledge-hub/finance-industry-trends\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"card-meta\\\",\\\"children\\\":[\\\"26 Oct 2018\\\",null]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"從數據制定營銷策略 – 金融、保險與投資篇\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"small muted\\\",\\\"children\\\":\\\"金融、保險與投資行業有一個先天性不利因素。在很多門外漢來說， finance industry 是沉悶、深奧、難明，甚至有點抗拒的東西。要克服顧客心中障礙並不容易，要在以吃喝玩樂為主的社交媒體做推廣就更加困難。 金融、保險與投資公司的 marketers 要採用什麼策略才能拉近與顧客的距離呢？\\\"}]]}]\\n37:[\\\"$\\\",\\\"$L16\\\",\\\"content-marketing-youtube-promotion-strategies\\\",{\\\"className\\\":\\\"card card--link\\\",\\\"href\\\":\\\"/en/knowledge-hub/content-marketing-youtube-promotion-strategies\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"card-meta\\\",\\\"children\\\":[\\\"6 Oct 2018\\\",null]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"Content Marketing︰YouTube 致勝秘訣之宣傳篇\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"small muted\\\",\\\"children\\\":\\\"YouTube 是最受香港人歡迎的影片分享平台，45% 香港人甚至表示 YouTube 可以代替電視，在 YouTube 投放廣告似乎理所當然。然而 Marketers 要跨過「5秒跳過」大關並不容易。究竟要如何製作讓人捨不得跳過的廣告呢？\\\"}]]}]\\n38:[\\\"$\\\",\\\"$L16\\\",\\\"content-marketing-youtube-strategies\\\",{\\\"className\\\":\\\"card card--link\\\",\\\"href\\\":\\\"/en/knowledge-hub/content-marketing-youtube-strategies\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"card-meta\\\",\\\"children\\\":[\\\"5 Oct 2018\\\",null]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"Content Marketing︰YouTube 致勝秘訣之策略篇\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"small muted\\\",\\\"children\\\":\\\"你知道全球每天花多少時間在YouTube上嗎？答案是10億小時。YouTube 已有 91% 香港人使用。其中近 50% 用戶每天都在 YouTube 觀看短片，絕對是品牌不能忽視的宣傳渠道。那麼，我們要怎樣制定成功有效的宣傳策略呢？\\\"}]]}]\\n39:[\\\"$\\\",\\\"$L16\\\",\\\"content-marketing-branding\\\",{\\\"className\\\":\\\"card card--link\\\",\\\"href\\\":\\\"/en/knowledge-hub/content-marketing-branding\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"card-meta\\\",\\\"children\\\":[\\\"3 Sept 2018\\\",null]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"Content Marketing︰「 抽水 」要小心！\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"small muted\\\",\\\"children\\\":\\\"最近香港運動員在海外屢獲殊榮，很多品牌都希望利用「 抽水 」貼文，借助這些話題為自己爭取一些曝光。但是這麼做可能為你惹來官非！早前就有外國品牌因為使用了國際體育運動的 hashtags 而收到舉辦機構的律師信。究竟我們怎樣才能「抽」得安心呢？\\\"}]]}]\\n3a:[\\\"$\\\",\\\"$L16\\\",\\\"content-marketing-facebook-algorithm\\\",{\\\"className\\\":\\\"card card--link\\\",\\\"href\\\":\\\"/en/knowledge-hub/content-marketing-facebook-algorithm\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"card-meta\\\",\\\"children\\\":[\\\"27 Aug 2018\\\",null]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"Content Marketing︰Facebook Algorithm 應對策略\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"small muted\\\",\\\"children\\\":\\\"品牌要在 Facebook 立足本來就不容易，今年1月的Facebook algorithm 更新更是雪上加霜。Merkle 調查顯示品牌廣告成本增加了40%，曝光卻減少了17%。要克服這艱難的經營環境，Marketers 要怎麼辦？Buffer 與 Buzzsumo 的調查結果可能嚇你一跳。\\\"}]]}]\\n3b:[\\\"$\\\",\\\"$L16\\\",\\\"content-marketing-\"])</script><script>self.__next_f.push([1,\"emoji\\\",{\\\"className\\\":\\\"card card--link\\\",\\\"href\\\":\\\"/en/knowledge-hub/content-marketing-emoji\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"card-meta\\\",\\\"children\\\":[\\\"17 Aug 2018\\\",null]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"Content Marketing︰品牌應不應該使用表情符號？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"small muted\\\",\\\"children\\\":\\\"與 hashtags 一樣，marketers 對品牌應不應該在社交媒體用表情符號 (emoji) 長期各執一詞。有些人認為使用表情符號可以拉近顧客與品牌的距離，但也有人認為表情符號與品牌格格不入。我們應如何選擇呢？\\\"}]]}]\\n3c:[\\\"$\\\",\\\"$L16\\\",\\\"content-marketing-neuromarketing\\\",{\\\"className\\\":\\\"card card--link\\\",\\\"href\\\":\\\"/en/knowledge-hub/content-marketing-neuromarketing\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"card-meta\\\",\\\"children\\\":[\\\"13 Aug 2018\\\",null]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"Content Marketing︰什麼是 Neuromarketing？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"small muted\\\",\\\"children\\\":\\\"潛意識其實影響著我們日常很多消費決擇，例如對事物的直覺觀感、目光停留在什麼地方、什麼才算「抵」等，因此只要了解顧客潛意識在想什麼，我們的推廣就自然事半功倍。\\\"}]]}]\\n3d:[\\\"$\\\",\\\"$L16\\\",\\\"evergreen-content\\\",{\\\"className\\\":\\\"card card--link\\\",\\\"href\\\":\\\"/en/knowledge-hub/evergreen-content\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"card-meta\\\",\\\"children\\\":[\\\"29 Sept 2017\\\",null]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"Content Marketing︰什麼是 Evergreen Content？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"small muted\\\",\\\"children\\\":\\\"Evergreen content 是所有內容的皇者，每次出現必然受萬民愛戴，表現超班。最緊要是，evergreen content 能為你提升 SEO 排名，讓你的網站及網店長期得到曝光，對營運至為重要。究竟什麼是 evergreen content 呢？\\\"}]]}]\\n3e:[\\\"$\\\",\\\"$L16\\\",\\\"content-marketing-content-curation\\\",{\\\"className\\\":\\\"card card--link\\\",\\\"href\\\":\\\"/en/knowledge-hub/content-marketing-content-curation\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"card-meta\\\",\\\"children\\\":[\\\"22 Nov 2016\\\",null]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"Content Marketing︰什麼是 Content Curation？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"small muted\\\",\\\"children\\\":\\\"我們經常說，品牌除了要「create」，還要 「curate」 內容 ，但是什麼是「content curation」呢？根據字典，「curate」的解釋是「策展」，但「策展」又是什麼呢？既然字典不能解答我們的問題，今天就讓我們深入探討「content curation」之謎！\\\"}]]}]\\n3f:[\\\"$\\\",\\\"$L16\\\",\\\"content-marketing-inbound-marketing\\\",{\\\"className\\\":\\\"card card--link\\\",\\\"href\\\":\\\"/en/knowledge-hub/content-marketing-inbound-marketing\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"card-meta\\\",\\\"children\\\":[\\\"8 Aug 2016\\\",null]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"Content Marketing︰什麼是 Inbound Marketing？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"small muted\\\",\\\"children\\\":\\\"你的廣告費用是否正在不斷上升？根據調查顯示，雖然平均 CPC 於十年間增加了 4.2 倍，但轉換率反而減少了。其實不少品牌都已發現單靠推送廣告已不能達到預期效果， inbound marketing 亦應運而生。究竟 Inbound marketing 是什麼？它又如何幫助品牌做到有效推廣？\\\"}]]}]\\n40:[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"marginTop\\\":32},\\\"children\\\":[\\\"$\\\",\\\"$L16\\\",null,{\\\"className\\\":\\\"text-link\\\",\\\"href\\\":\\\"/en/knowledge-hub\\\",\\\"children\\\":[\\\"← \\\",\\\"All articles\\\"]}]}]\\nb:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"2\\\",{\\\"name\\\":\\\"theme-color\\\",\\\"content\\\":\\\"#ffffff\\\"}]]\\n8:null\\nd:[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"Content Ma